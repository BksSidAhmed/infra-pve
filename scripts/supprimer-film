#!/usr/bin/env python3
"""supprimer-film — supprime proprement un film de la médiathèque.

À lancer sur l'hôte pve (installé dans /usr/local/bin/supprimer-film) :
    supprimer-film "harry potter"
    supprimer-film --test "harry potter"   # montre ce qui serait fait, ne supprime rien

Ce que fait la commande, après confirmation :
  1. retire le film de Radarr (CT 101) avec ses fichiers dans /data/media,
     pour qu'il ne soit pas re-téléchargé ;
  2. supprime le torrent correspondant dans qBittorrent avec son fichier
     dans /data/downloads (sinon la place n'est pas libérée).
La clé API Radarr est lue à chaque lancement dans le CT 101 : aucun secret dans ce script.
"""
import json
import re
import subprocess
import sys
import urllib.parse
import urllib.request

CT = "101"
RADARR = "http://192.168.1.101:7878/api/v3"


def pct(*cmd):
    return subprocess.run(["pct", "exec", CT, "--", *cmd],
                          capture_output=True, text=True, check=True).stdout


def radarr_key():
    xml = pct("cat", "/opt/arr/config/radarr/config.xml")
    return re.search(r"<ApiKey>(.*?)</ApiKey>", xml).group(1)


def radarr(key, path, method="GET"):
    req = urllib.request.Request(RADARR + path, method=method, headers={"X-Api-Key": key})
    with urllib.request.urlopen(req, timeout=30) as r:
        body = r.read()
    return json.loads(body) if body else None


def qbit(path, data=None):
    # qBittorrent n'accepte sans mot de passe que les appels locaux : on passe par gluetun.
    url = "http://127.0.0.1:8080/api/v2/" + path
    cmd = ["docker", "exec", "gluetun", "wget", "-qO-"]
    if data is not None:
        cmd += ["--post-data", urllib.parse.urlencode(data)]
    out = pct(*cmd, url)
    return json.loads(out) if out.strip().startswith(("[", "{")) else out


def go(n):
    return f"{n / 1e9:.1f} Go"


def main():
    args = [a for a in sys.argv[1:] if a != "--test"]
    test = "--test" in sys.argv
    if not args:
        print(__doc__)
        sys.exit(1)
    recherche = " ".join(args).lower()

    key = radarr_key()
    films = [m for m in radarr(key, "/movie")
             if recherche in m["title"].lower()
             or recherche in (m.get("originalTitle") or "").lower()
             or recherche in m.get("folderName", m.get("path", "")).lower()]
    if not films:
        print(f"Aucun film trouvé pour « {recherche} ».")
        sys.exit(1)

    films.sort(key=lambda m: (m["title"], m.get("year", 0)))
    for i, m in enumerate(films, 1):
        taille = go(m.get("sizeOnDisk", 0)) if m.get("hasFile") else "pas de fichier"
        print(f"  {i}. {m['title']} ({m.get('year')}) — {taille}")
    if len(films) > 1:
        choix = input("Numéro du film à supprimer (Entrée pour annuler) : ").strip()
        if not choix.isdigit() or not 1 <= int(choix) <= len(films):
            print("Annulé.")
            return
        film = films[int(choix) - 1]
    else:
        film = films[0]

    # Torrent(s) liés : identifiants de téléchargement dans l'historique Radarr.
    hist = radarr(key, f"/history/movie?movieId={film['id']}")
    ids = {h["downloadId"].lower() for h in hist if h.get("downloadId")}
    torrents = [t for t in qbit("torrents/info?filter=all") if t["hash"].lower() in ids]

    print(f"\nFilm : {film['title']} ({film.get('year')})")
    print(f"  Radarr : retiré, avec le dossier {film.get('path')}")
    for t in torrents:
        print(f"  qBittorrent : torrent « {t['name']} » ({go(t['size'])}) et son fichier")
    if not torrents:
        print("  qBittorrent : aucun torrent lié trouvé (déjà supprimé ?)")

    if test:
        print("\nMode test : rien n'a été supprimé.")
        return
    if input("\nTaper « oui » pour confirmer : ").strip().lower() != "oui":
        print("Annulé.")
        return

    radarr(key, f"/movie/{film['id']}?deleteFiles=true&addImportExclusion=false", "DELETE")
    print("✓ Retiré de Radarr (fichiers du dossier media supprimés)")
    if torrents:
        qbit("torrents/delete", {"hashes": "|".join(t["hash"] for t in torrents), "deleteFiles": "true"})
        print("✓ Torrent et fichier de téléchargement supprimés dans qBittorrent")
    print("Terminé. Plex retirera le film à sa prochaine analyse de la bibliothèque.")


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print("\nAnnulé.")
    except subprocess.CalledProcessError as e:
        sys.exit(f"Erreur pendant « {' '.join(e.cmd)} » : {e.stderr.strip()}")
