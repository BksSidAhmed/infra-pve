#!/usr/bin/env python3
"""Alerte ntfy quand C411 bloque les téléchargements (marge épuisée).

    alerte-c411          # vérifie et envoie l'alerte si besoin (cron toutes les heures)
    alerte-c411 --test   # affiche l'état sans rien envoyer

Regarde les torrents en cours de téléchargement dans qBittorrent (CT 101) : si le tracker
C411 répond « Forbidden » (statut 4), C411 bloque les téléchargements. Une alerte quand le
blocage commence (puis au plus une par jour), une autre quand il est levé.
Sujets ntfy : les mêmes que films-introuvables (/etc/films-introuvables.conf, NTFY_TOPICS=).
État : /var/lib/alerte-c411.json. Voir conteneurs/101-arr.md du dépôt infra-pve.
"""
import json, subprocess, sys, time, urllib.request

CONF = "/etc/films-introuvables.conf"
ETAT = "/var/lib/alerte-c411.json"
EN_TELECHARGEMENT = {"downloading", "stalledDL", "metaDL", "forcedDL", "queuedDL", "checkingDL"}
RAPPEL = 24 * 3600
TEST = "--test" in sys.argv


def qbt(chemin):
    sortie = subprocess.run(["pct", "exec", "101", "--", "docker", "exec", "qbittorrent", "curl", "-s",
                             "http://localhost:8080/api/v2/" + chemin],
                            capture_output=True, text=True, check=True).stdout
    return json.loads(sortie)


def ntfy(titre, texte):
    if TEST:
        print("[test] ntfy :", titre, "-", texte)
        return
    sujets = ""
    for ligne in open(CONF, encoding="utf-8"):
        if ligne.startswith("NTFY_TOPICS="):
            sujets = ligne.split("=", 1)[1].strip()
    for sujet in filter(None, (s.strip() for s in sujets.split(","))):
        requete = urllib.request.Request("https://ntfy.sh/" + sujet, data=texte.encode(),
                                         headers={"Title": titre.encode("utf-8"), "Tags": "warning"})
        urllib.request.urlopen(requete, timeout=20)


def main():
    bloques = []
    for t in qbt("torrents/info"):
        if t["state"] not in EN_TELECHARGEMENT:
            continue
        for tr in qbt("torrents/trackers?hash=" + t["hash"]):
            if "c411" in tr["url"] and tr["status"] == 4:
                bloques.append(t["name"])
                break
    info = qbt("transfer/info")
    ratio = info["up_info_data"] / max(info["dl_info_data"], 1)

    try:
        etat = json.load(open(ETAT))
    except (OSError, ValueError):
        etat = {"bloque": False, "derniere_alerte": 0}
    maintenant = time.time()
    print(time.strftime("%Y-%m-%d %H:%M"), "bloqués :", len(bloques), "ratio session : %.2f" % ratio)

    if bloques:
        if not etat["bloque"] or maintenant - etat["derniere_alerte"] > RAPPEL:
            ntfy("C411 bloque les téléchargements",
                 "Marge épuisée : %d téléchargement(s) en attente (%s). Le partage continue, "
                 "vérifier la marge sur le site." % (len(bloques), ", ".join(n[:40] for n in bloques[:3])))
            etat["derniere_alerte"] = maintenant
        etat["bloque"] = True
    elif etat["bloque"]:
        ntfy("C411 débloqué", "Les téléchargements C411 ont repris.")
        etat["bloque"] = False

    if not TEST:
        json.dump(etat, open(ETAT, "w"))


main()
